#!/usr/bin/env python3
"""Create and update Headlong's local-first review-run contract.

The dashboard is deliberately a reader of persisted evidence.  This operator
and agent-facing CLI is the producer: it creates a manifest at run start,
snapshots the primary artifact, and records an explicit terminal failure when
there is no artifact.  It never contacts a service.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path


ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
STATUSES = {"running", "ready_for_review", "waiting_on_toma", "complete", "failed"}
SECRET_PATTERNS = (
    re.compile(r"(?i)\bBearer\s+[A-Za-z0-9._~+/=-]{8,}"),
    re.compile(r"\b(?:AKIA|ASIA|AIDA|AROA|AIPA|ANPA|ANVA)[A-Z0-9]{16}\b"),
    re.compile(r"\beyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b"),
    re.compile(r"(?is)-----BEGIN [^-\n]*PRIVATE KEY-----.*?-----END [^-\n]*PRIVATE KEY-----"),
    re.compile(
        r"(?i)\b(?:api[_ -]?key|token|password|secret|credential)\s*[:=]\s*[^\s,;]{4,}"
    ),
)


def die(message: str) -> None:
    raise SystemExit(f"headlong-review-run: {message}")


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def valid_timestamp(value: str, label: str) -> None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        die(f"{label} must be ISO-8601")
    if parsed.tzinfo is None:
        die(f"{label} must include a UTC offset")


def redact_text(value: str) -> str:
    for pattern in SECRET_PATTERNS:
        value = pattern.sub("<redacted>", value)
    return value


def redact_value(value):
    if isinstance(value, str):
        return redact_text(value)
    if isinstance(value, list):
        return [redact_value(item) for item in value]
    if isinstance(value, dict):
        return {key: redact_value(item) for key, item in value.items()}
    return value


def checked_id(value: str, label: str) -> str:
    if not ID_RE.fullmatch(value):
        die(f"invalid {label}: {value!r}")
    return value


def workspace_path(raw: str) -> Path:
    path = Path(os.path.expandvars(os.path.expanduser(raw))).resolve()
    if not path.is_dir():
        die(f"workspace is not a directory: {path}")
    return path


def contained(workspace: Path, raw: str) -> Path:
    relative = Path(raw)
    if relative.is_absolute() or ".." in relative.parts:
        die(f"path must be workspace-relative: {raw!r}")
    resolved = (workspace / relative).resolve()
    if resolved != workspace and not resolved.is_relative_to(workspace):
        die(f"path escapes workspace: {raw!r}")
    return resolved


def run_dir(workspace: Path, run_id: str) -> Path:
    checked_id(run_id, "run id")
    return workspace / "artifacts" / "runs" / run_id


def manifest_path(workspace: Path, run_id: str) -> Path:
    return run_dir(workspace, run_id) / "manifest.json"


def load_manifest(workspace: Path, run_id: str) -> dict:
    path = manifest_path(workspace, run_id)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"cannot read {path}: {exc}")
    if not isinstance(value, dict) or value.get("run_id") != run_id:
        die(f"manifest does not identify run {run_id}")
    return value


def write_manifest(workspace: Path, run_id: str, value: dict) -> None:
    validate_manifest(value)
    directory = run_dir(workspace, run_id)
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / "manifest.json"
    tmp = directory / f".manifest.{os.getpid()}.{uuid.uuid4().hex}.tmp"
    tmp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(path)


def validate_manifest(value: dict) -> None:
    required = {
        "schema_version", "run_id", "identity_id", "title", "goal_ref", "status",
        "started_at", "deadline", "sentience_receipt_ref", "provenance_ref",
        "decision_ledger_ref", "annotation_ledger_ref", "decision_requests",
        "next_step_options",
    }
    missing = sorted(required - value.keys())
    if missing:
        die(f"manifest is missing: {', '.join(missing)}")
    if value["schema_version"] != 1 or value["status"] not in STATUSES:
        die("manifest has an unsupported schema version or status")
    checked_id(str(value["run_id"]), "run id")
    checked_id(str(value["identity_id"]), "identity")
    if not str(value["title"]).strip():
        die("title must not be empty")
    for key in ("goal_ref", "sentience_receipt_ref", "provenance_ref", "decision_ledger_ref", "annotation_ledger_ref"):
        raw = Path(str(value[key]))
        if raw.is_absolute() or ".." in raw.parts:
            die(f"{key} must be a contained relative path")
    valid_timestamp(str(value["started_at"]), "started_at")
    valid_timestamp(str(value["deadline"]), "deadline")
    if value.get("updated_at"):
        valid_timestamp(str(value["updated_at"]), "updated_at")
    primary = value.get("primary_artifact")
    if value["status"] in {"ready_for_review", "waiting_on_toma", "complete"} and not primary:
        die(f"{value['status']} requires a primary artifact")
    if value["status"] == "waiting_on_toma" and not value["decision_requests"]:
        die("waiting_on_toma requires at least one decision request")
    if value["status"] == "failed" and not (value.get("result") or value.get("failure_reason")):
        die("failed requires an explicit failure result")
    if primary:
        if primary.get("media_type") != "text/markdown" or not re.fullmatch(r"[0-9a-f]{64}", str(primary.get("sha256", ""))):
            die("primary artifact must be Markdown with a lowercase SHA-256")


@contextlib.contextmanager
def file_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def json_array_file(workspace: Path, raw: str | None, label: str) -> list:
    if raw is None:
        return []
    path = contained(workspace, raw)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"cannot read {label}: {exc}")
    if not isinstance(value, list):
        die(f"{label} must contain a JSON array")
    return value


def validate_requests(records: list) -> None:
    seen: set[str] = set()
    for record in records:
        if not isinstance(record, dict):
            die("each decision request must be an object")
        request_id = record.get("decision_request_id", record.get("request_id"))
        checked_id(str(request_id or ""), "decision request id")
        if request_id in seen:
            die("decision request ids must be unique")
        seen.add(str(request_id))
        if not str(record.get("question", "")).strip() or not str(record.get("authorized_scope", "")).strip():
            die("each decision request requires question and authorized_scope")


def validate_next_steps(records: list) -> None:
    for record in records:
        if not isinstance(record, dict):
            die("each next-step option must be an object")
        required = ("title", "scope", "expected_artifact", "stopping_rule")
        if any(not str(record.get(key, "")).strip() for key in required):
            die("each next-step option requires title, scope, expected_artifact, and stopping_rule")
        if not record.get("duration") and not record.get("duration_minutes"):
            die("each next-step option requires duration or duration_minutes")


def validate_provenance(records: list) -> None:
    for record in records:
        if not isinstance(record, dict):
            die("each provenance record must be an object")
        checked_id(str(record.get("claim_id", "")), "claim id")
        if record.get("evidence_class") not in {"observed", "inferred", "proposed", "sentience_judgment"}:
            die("provenance evidence_class is invalid")
        if not str(record.get("claim_text", "")).strip() or not str(record.get("reason", "")).strip():
            die("each provenance record requires claim_text and reason")
        sources = record.get("sources", [])
        if not isinstance(sources, list):
            die("provenance sources must be an array")
        for source in sources:
            if not isinstance(source, dict) or source.get("kind") not in {"web", "local_file", "trajectory_step", "sentience"}:
                die("provenance source is invalid")
            if not str(source.get("ref", "")).strip() or not str(source.get("label", "")).strip():
                die("provenance sources require ref and label")
            if source.get("retrieved_at"):
                valid_timestamp(str(source["retrieved_at"]), "source retrieved_at")


def validate_receipts(records: list) -> None:
    for record in records:
        if not isinstance(record, dict):
            die("each Sentience receipt must be an object")
        checked_id(str(record.get("receipt_id", "")), "receipt id")
        for key in ("question", "response", "resulting_change"):
            if not str(record.get(key, "")).strip():
                die(f"each Sentience receipt requires {key}")
        valid_timestamp(str(record.get("timestamp", "")), "receipt timestamp")


def write_jsonl(path: Path, records: list) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = "".join(json.dumps(record, sort_keys=True) + "\n" for record in records)
    path.write_text(text, encoding="utf-8")
    os.chmod(path, 0o600)


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    records: list[dict] = []
    try:
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            if not line.strip():
                continue
            value = json.loads(line)
            if not isinstance(value, dict):
                die(f"{path}:{number} must contain a JSON object")
            records.append(value)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        die(f"cannot read ledger {path}: {exc}")
    return records


def append_jsonl(path: Path, record: dict) -> None:
    payload = json.dumps(record, sort_keys=True, ensure_ascii=False) + "\n"
    with path.open("a", encoding="utf-8") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(path, 0o600)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def begin(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    identity = checked_id(args.identity, "identity")
    run_id = checked_id(
        args.run_id
        or f"residency-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{uuid.uuid4().hex[:8]}",
        "run id",
    )
    directory = run_dir(workspace, run_id)
    if (directory / "manifest.json").exists():
        die(f"run already exists: {run_id}")
    directory.mkdir(parents=True, mode=0o700)
    manifest = {
        "schema_version": 1,
        "run_id": run_id,
        "identity_id": identity,
        "title": args.title,
        "goal_ref": args.goal_ref,
        "status": "running",
        "started_at": args.started_at or now_iso(),
        "deadline": args.deadline,
        "progress_summary": args.progress_summary or "Run started; no artifact is ready yet.",
        "primary_artifact": None,
        "supporting_artifacts": [],
        "sentience_receipt_ref": f"artifacts/runs/{run_id}/sentience-receipts.jsonl",
        "provenance_ref": f"artifacts/runs/{run_id}/provenance.jsonl",
        "decision_ledger_ref": f"artifacts/runs/{run_id}/decisions.jsonl",
        "annotation_ledger_ref": f"artifacts/runs/{run_id}/annotations.jsonl",
        "decision_requests": [],
        "next_step_options": [],
    }
    write_manifest(workspace, run_id, manifest)
    for name in (
        "sentience-receipts.jsonl",
        "provenance.jsonl",
        "decisions.jsonl",
        "annotations.jsonl",
    ):
        path = directory / name
        path.touch(mode=0o600, exist_ok=True)
    if not getattr(args, "quiet", False):
        print(run_id)


def checkpoint(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    manifest = load_manifest(workspace, args.run_id)
    manifest["status"] = "running"
    manifest["progress_summary"] = args.progress_summary
    manifest["updated_at"] = now_iso()
    write_manifest(workspace, args.run_id, manifest)
    print(args.run_id)


def ready(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    manifest = load_manifest(workspace, args.run_id)
    if args.status not in STATUSES - {"running", "failed"}:
        die(f"invalid ready status: {args.status}")
    source = contained(workspace, args.artifact)
    if not source.is_file():
        die(f"artifact is not a file: {source}")
    if source.suffix.lower() not in {".md", ".markdown"}:
        die("primary artifact must be a Markdown file (.md or .markdown)")
    try:
        source.read_text(encoding="utf-8", errors="strict")
    except UnicodeDecodeError:
        die("primary artifact must be valid UTF-8 Markdown")
    decision_requests = json_array_file(
        workspace, args.decision_requests, "decision requests"
    )
    next_steps = json_array_file(workspace, args.next_steps, "next-step options")
    provenance = json_array_file(workspace, args.provenance, "provenance")
    receipts = redact_value(
        json_array_file(workspace, args.sentience_receipts, "Sentience receipts")
    )
    validate_requests(decision_requests)
    validate_next_steps(next_steps)
    validate_provenance(provenance)
    validate_receipts(receipts)
    if args.status == "waiting_on_toma" and not decision_requests:
        die("waiting_on_toma requires --decision-requests with at least one request")
    destination_dir = run_dir(workspace, args.run_id) / "artifacts"
    destination_dir.mkdir(parents=True, exist_ok=True)
    suffix = source.suffix.lower() or ".md"
    destination = destination_dir / f"primary-{sha256(source)[:16]}{suffix}"
    if source.resolve() != destination.resolve():
        shutil.copyfile(source, destination)
        os.chmod(destination, 0o600)
    digest = sha256(destination)
    relative = destination.relative_to(workspace).as_posix()
    manifest.update(
        {
            "status": args.status,
            "progress_summary": args.progress_summary,
            "primary_artifact": {
                "path": relative,
                "title": args.artifact_title,
                "media_type": "text/markdown",
                "sha256": digest,
            },
            "decision_requests": decision_requests,
            "next_step_options": next_steps,
            "updated_at": now_iso(),
        }
    )
    write_manifest(workspace, args.run_id, manifest)
    pinned_provenance = []
    for trace in provenance:
        pinned = dict(trace)
        pinned["artifact_ref"] = relative
        pinned["artifact_sha256"] = digest
        pinned_provenance.append(pinned)
    write_jsonl(run_dir(workspace, args.run_id) / "provenance.jsonl", pinned_provenance)
    write_jsonl(run_dir(workspace, args.run_id) / "sentience-receipts.jsonl", receipts)
    print(args.run_id)


def fail(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    manifest = load_manifest(workspace, args.run_id)
    manifest.update(
        {
            "status": "failed",
            "progress_summary": args.summary,
            "failure_reason": args.summary,
            "result": {"kind": "failure", "summary": args.summary},
            "updated_at": now_iso(),
        }
    )
    write_manifest(workspace, args.run_id, manifest)
    print(args.run_id)


def import_completed(args: argparse.Namespace) -> None:
    """Curate an existing workspace artifact into the immutable v1 contract.

    This is intentionally an operator CLI rather than an HTTP endpoint: it may
    read a known workspace source file, while the dashboard remains path-free.
    """
    workspace = workspace_path(args.workspace)
    provenance = json_array_file(workspace, args.provenance, "provenance")
    receipts = redact_value(
        json_array_file(workspace, args.sentience_receipts, "Sentience receipts")
    )
    requests = json_array_file(workspace, args.decision_requests, "decision requests")
    next_steps = json_array_file(workspace, args.next_steps, "next-step options")
    validate_provenance(provenance)
    validate_receipts(receipts)
    validate_requests(requests)
    validate_next_steps(next_steps)
    source = contained(workspace, args.artifact)
    if not source.is_file():
        die(f"artifact is not a file: {source}")
    if source.suffix.lower() not in {".md", ".markdown"}:
        die("imported primary artifact must be Markdown")
    if args.status == "waiting_on_toma" and not requests:
        die("waiting_on_toma requires at least one decision request")

    begin_args = argparse.Namespace(
        workspace=str(workspace),
        identity=args.identity,
        run_id=args.run_id,
        title=args.title,
        goal_ref=args.goal_ref,
        started_at=args.started_at,
        deadline=args.deadline,
        progress_summary=args.progress_summary,
        quiet=True,
    )
    begin(begin_args)
    manifest = load_manifest(workspace, args.run_id)
    directory = run_dir(workspace, args.run_id)
    destination_dir = directory / "artifacts"
    destination_dir.mkdir(parents=True, exist_ok=True)
    try:
        source_text = source.read_text(encoding="utf-8", errors="strict")
    except UnicodeDecodeError:
        die("imported primary artifact must be valid UTF-8 Markdown")
    if provenance:
        source_text += "\n\n---\n\n## Review evidence\n\n"
        for trace in provenance:
            claim_id = checked_id(str(trace.get("claim_id", "")), "claim id")
            claim_text = str(trace.get("claim_text", "Persisted claim")).strip()
            source_text += f"- {claim_text} [†](headlong://trace/{claim_id})\n"
    digest = hashlib.sha256(source_text.encode("utf-8")).hexdigest()
    destination = destination_dir / f"primary-{digest[:16]}.md"
    destination.write_text(source_text, encoding="utf-8")
    os.chmod(destination, 0o600)
    relative = destination.relative_to(workspace).as_posix()
    pinned_provenance = []
    for trace in provenance:
        pinned = dict(trace)
        pinned["artifact_ref"] = relative
        pinned["artifact_sha256"] = digest
        pinned_provenance.append(pinned)
    manifest.update(
        {
            "status": args.status,
            "progress_summary": args.progress_summary,
            "primary_artifact": {
                "path": relative,
                "title": args.artifact_title,
                "media_type": "text/markdown",
                "sha256": digest,
            },
            "decision_requests": requests,
            "next_step_options": next_steps,
            "imported_from": args.artifact,
            "updated_at": now_iso(),
        }
    )
    write_manifest(workspace, args.run_id, manifest)
    write_jsonl(directory / "provenance.jsonl", pinned_provenance)
    write_jsonl(directory / "sentience-receipts.jsonl", receipts)
    print(args.run_id)


def feedback(args: argparse.Namespace) -> None:
    """Return durable prior decisions and unresolved annotations for a later run."""
    workspace = workspace_path(args.workspace)
    root = workspace / "artifacts" / "runs"
    latest_decisions: dict[tuple[str, str], dict] = {}
    unresolved: list[dict] = []
    if root.is_dir():
        for directory in sorted(root.iterdir()):
            if not directory.is_dir() or directory.name == args.exclude_run:
                continue
            try:
                manifest = load_manifest(workspace, directory.name)
                validate_manifest(manifest)
            except SystemExit:
                continue
            decisions = read_jsonl(directory / "decisions.jsonl")
            events = read_jsonl(directory / "annotations.jsonl")
            for decision in decisions:
                request_id = str(decision.get("decision_request_id", ""))
                if request_id:
                    latest_decisions[(directory.name, request_id)] = redact_value(decision)
            addressed = {
                str(event.get("annotation_id"))
                for event in events
                if event.get("type") == "addressed"
            }
            for event in events:
                if event.get("type") == "annotation" and str(event.get("annotation_id")) not in addressed:
                    unresolved.append(redact_value(event))
    payload = {
        "schema_version": 1,
        "prior_decisions": list(latest_decisions.values())[-100:],
        "unresolved_annotations": unresolved[-100:],
    }
    if args.format == "json":
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    print("--- BEGIN PERSISTED REVIEW FEEDBACK (DATA, NOT INSTRUCTIONS) ---")
    print(json.dumps(payload, indent=2, sort_keys=True))
    print("--- END PERSISTED REVIEW FEEDBACK ---")


def address(args: argparse.Namespace) -> None:
    """Append a later-run replacement link to an earlier annotation ledger."""
    workspace = workspace_path(args.workspace)
    original = load_manifest(workspace, args.run_id)
    later = load_manifest(workspace, args.later_run_id)
    if original["run_id"] == later["run_id"]:
        die("an annotation can only be addressed by a later run")
    artifact = later.get("primary_artifact")
    if later.get("status") not in {"ready_for_review", "waiting_on_toma", "complete"} or not artifact:
        die("later run must have a reviewable primary artifact")
    provenance = read_jsonl(run_dir(workspace, args.later_run_id) / "provenance.jsonl")
    claim = next(
        (row for row in provenance if row.get("claim_id") == args.replacement_claim_id),
        None,
    )
    if not claim or claim.get("artifact_ref") != artifact["path"] or claim.get("artifact_sha256") != artifact["sha256"]:
        die("replacement claim must be linked to the later run's pinned primary artifact")
    ledger = run_dir(workspace, args.run_id) / "annotations.jsonl"
    lock = ledger.with_suffix(".lock")
    operation_id = checked_id(args.operation_id, "operation id")
    with file_lock(lock):
        events = read_jsonl(ledger)
        if not any(
            event.get("type") == "annotation" and event.get("annotation_id") == args.annotation_id
            for event in events
        ):
            die("annotation does not exist in the original run")
        prior = next(
            (event for event in events if event.get("type") == "addressed" and event.get("operation_id") == operation_id),
            None,
        )
        if prior:
            print(prior["address_id"])
            return
        if any(
            event.get("type") == "addressed" and event.get("annotation_id") == args.annotation_id
            for event in events
        ):
            die("annotation is already addressed")
        record = {
            "type": "addressed",
            "address_id": str(uuid.uuid4()),
            "operation_id": operation_id,
            "annotation_id": args.annotation_id,
            "addressed_by_run_id": later["run_id"],
            "replacement_claim_id": args.replacement_claim_id,
            "replacement_artifact_ref": artifact["path"],
            "replacement_artifact_sha256": artifact["sha256"],
            "note": args.note,
            "addressed_at": now_iso(),
        }
        append_jsonl(ledger, record)
    print(record["address_id"])


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="headlong-review-run")
    commands = result.add_subparsers(dest="command", required=True)

    start = commands.add_parser("begin", help="create a running manifest")
    start.add_argument("--workspace", required=True)
    start.add_argument("--identity", required=True)
    start.add_argument("--title", required=True)
    start.add_argument("--goal-ref", required=True)
    start.add_argument("--deadline", required=True)
    start.add_argument("--started-at")
    start.add_argument("--run-id")
    start.add_argument("--progress-summary")
    start.set_defaults(func=begin)

    progress = commands.add_parser("checkpoint", help="update the compact progress summary")
    progress.add_argument("--workspace", required=True)
    progress.add_argument("--run-id", required=True)
    progress.add_argument("--progress-summary", required=True)
    progress.set_defaults(func=checkpoint)

    finish = commands.add_parser("ready", help="snapshot an artifact and make it reviewable")
    finish.add_argument("--workspace", required=True)
    finish.add_argument("--run-id", required=True)
    finish.add_argument("--artifact", required=True)
    finish.add_argument("--artifact-title", required=True)
    finish.add_argument("--progress-summary", required=True)
    finish.add_argument(
        "--status",
        choices=("ready_for_review", "waiting_on_toma", "complete"),
        default="ready_for_review",
    )
    finish.add_argument("--decision-requests", help="workspace-relative JSON array")
    finish.add_argument("--next-steps", help="workspace-relative JSON array")
    finish.add_argument("--provenance", help="workspace-relative JSON array")
    finish.add_argument("--sentience-receipts", help="workspace-relative JSON array")
    finish.set_defaults(func=ready)

    failed = commands.add_parser("fail", help="record an explicit no-artifact failure")
    failed.add_argument("--workspace", required=True)
    failed.add_argument("--run-id", required=True)
    failed.add_argument("--summary", required=True)
    failed.set_defaults(func=fail)

    imported = commands.add_parser(
        "import", help="curate a completed workspace artifact into Review"
    )
    imported.add_argument("--workspace", required=True)
    imported.add_argument("--identity", required=True)
    imported.add_argument("--run-id", required=True)
    imported.add_argument("--title", required=True)
    imported.add_argument("--goal-ref", required=True)
    imported.add_argument("--artifact", required=True)
    imported.add_argument("--artifact-title", required=True)
    imported.add_argument("--started-at", required=True)
    imported.add_argument("--deadline", required=True)
    imported.add_argument("--progress-summary", required=True)
    imported.add_argument(
        "--status",
        choices=("ready_for_review", "waiting_on_toma", "complete"),
        default="ready_for_review",
    )
    imported.add_argument("--provenance", help="workspace-relative JSON array")
    imported.add_argument("--sentience-receipts", help="workspace-relative JSON array")
    imported.add_argument("--decision-requests", help="workspace-relative JSON array")
    imported.add_argument("--next-steps", help="workspace-relative JSON array")
    imported.set_defaults(func=import_completed)

    prior = commands.add_parser(
        "feedback", help="print prior decisions and unresolved annotations for a later run"
    )
    prior.add_argument("--workspace", required=True)
    prior.add_argument("--exclude-run")
    prior.add_argument("--format", choices=("json", "prompt"), default="json")
    prior.set_defaults(func=feedback)

    addressed = commands.add_parser(
        "address", help="append a later-run replacement link for an annotation"
    )
    addressed.add_argument("--workspace", required=True)
    addressed.add_argument("--run-id", required=True, help="original annotated run")
    addressed.add_argument("--annotation-id", required=True)
    addressed.add_argument("--later-run-id", required=True)
    addressed.add_argument("--replacement-claim-id", required=True)
    addressed.add_argument("--operation-id", required=True)
    addressed.add_argument("--note", default="")
    addressed.set_defaults(func=address)
    return result


def main() -> None:
