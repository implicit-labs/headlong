#!/usr/bin/env python3
"""Create and update Headlong's local-first review-run contract.

The dashboard is deliberately a reader of persisted evidence.  This operator
and agent-facing CLI is the producer: it creates a manifest at run start,
snapshots the primary artifact, and records an explicit terminal failure when
there is no artifact.  It never contacts a service.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path


ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
STATUSES = {"running", "ready_for_review", "waiting_on_toma", "complete", "failed"}
SECRET_PATTERNS = (
    re.compile(r"(?i)\bBearer\s+[A-Za-z0-9._~+/=-]{8,}"),
    re.compile(r"\b(?:AKIA|ASIA|AIDA|AROA|AIPA|ANPA|ANVA)[A-Z0-9]{16}\b"),
    re.compile(r"\beyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b"),
    re.compile(r"(?is)-----BEGIN [^-\n]*PRIVATE KEY-----.*?-----END [^-\n]*PRIVATE KEY-----"),
    re.compile(
        r"(?i)\b(?:api[_ -]?key|token|password|secret|credential)\s*[:=]\s*[^\s,;]{4,}"
    ),
)


def die(message: str) -> None:
    raise SystemExit(f"headlong-review-run: {message}")


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def valid_timestamp(value: str, label: str) -> None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        die(f"{label} must be ISO-8601")
    if parsed.tzinfo is None:
        die(f"{label} must include a UTC offset")


def redact_text(value: str) -> str:
    for pattern in SECRET_PATTERNS:
        value = pattern.sub("<redacted>", value)
    return value


def redact_value(value):
    if isinstance(value, str):
        return redact_text(value)
    if isinstance(value, list):
        return [redact_value(item) for item in value]
    if isinstance(value, dict):
        return {key: redact_value(item) for key, item in value.items()}
    return value


def checked_id(value: str, label: str) -> str:
    if not ID_RE.fullmatch(value):
        die(f"invalid {label}: {value!r}")
    return value


def workspace_path(raw: str) -> Path:
    path = Path(os.path.expandvars(os.path.expanduser(raw))).resolve()
    if not path.is_dir():
        die(f"workspace is not a directory: {path}")
    return path


def contained(workspace: Path, raw: str) -> Path:
    relative = Path(raw)
    if relative.is_absolute() or ".." in relative.parts:
        die(f"path must be workspace-relative: {raw!r}")
    resolved = (workspace / relative).resolve()
    if resolved != workspace and not resolved.is_relative_to(workspace):
        die(f"path escapes workspace: {raw!r}")
    return resolved


def run_dir(workspace: Path, run_id: str) -> Path:
    checked_id(run_id, "run id")
    return workspace / "artifacts" / "runs" / run_id


def manifest_path(workspace: Path, run_id: str) -> Path:
    return run_dir(workspace, run_id) / "manifest.json"


def load_manifest(workspace: Path, run_id: str) -> dict:
    path = manifest_path(workspace, run_id)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"cannot read {path}: {exc}")
    if not isinstance(value, dict) or value.get("run_id") != run_id:
        die(f"manifest does not identify run {run_id}")
    return value


def write_manifest(workspace: Path, run_id: str, value: dict) -> None:
    validate_manifest(value)
    directory = run_dir(workspace, run_id)
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / "manifest.json"
    tmp = directory / f".manifest.{os.getpid()}.{uuid.uuid4().hex}.tmp"
    tmp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(path)


def validate_manifest(value: dict) -> None:
    required = {
        "schema_version", "run_id", "identity_id", "title", "goal_ref", "status",
        "started_at", "deadline", "sentience_receipt_ref", "provenance_ref",
        "decision_ledger_ref", "annotation_ledger_ref", "decision_requests",
        "next_step_options",
    }
    missing = sorted(required - value.keys())
    if missing:
        die(f"manifest is missing: {', '.join(missing)}")
    if value["schema_version"] != 1 or value["status"] not in STATUSES:
        die("manifest has an unsupported schema version or status")
    checked_id(str(value["run_id"]), "run id")
    checked_id(str(value["identity_id"]), "identity")
    if not str(value["title"]).strip():
        die("title must not be empty")
    for key in ("goal_ref", "sentience_receipt_ref", "provenance_ref", "decision_ledger_ref", "annotation_ledger_ref"):
        raw = Path(str(value[key]))
        if raw.is_absolute() or ".." in raw.parts:
            die(f"{key} must be a contained relative path")
    valid_timestamp(str(value["started_at"]), "started_at")
    valid_timestamp(str(value["deadline"]), "deadline")
    if value.get("updated_at"):
        valid_timestamp(str(value["updated_at"]), "updated_at")
    primary = value.get("primary_artifact")
    if value["status"] in {"ready_for_review", "waiting_on_toma", "complete"} and not primary:
        die(f"{value['status']} requires a primary artifact")
    if value["status"] == "waiting_on_toma" and not value["decision_requests"]:
        die("waiting_on_toma requires at least one decision request")
    if value["status"] == "failed" and not (value.get("result") or value.get("failure_reason")):
        die("failed requires an explicit failure result")
    if primary:
        if primary.get("media_type") not in set(ARTIFACT_MEDIA.values()) or not re.fullmatch(r"[0-9a-f]{64}", str(primary.get("sha256", ""))):
            die("primary artifact must be Markdown, SVG, or a brief, with a lowercase SHA-256")


@contextlib.contextmanager
def file_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def json_array_file(workspace: Path, raw: str | None, label: str) -> list:
    if raw is None:
        return []
    path = contained(workspace, raw)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        die(f"cannot read {label}: {exc}")
    if not isinstance(value, list):
        die(f"{label} must contain a JSON array")
    return value


BRIEF_QUESTION_MAX = 120
BRIEF_FINDING_MAX = 320
HEADLINE_MAX = 80
SUMMARY_MAX = 220


def validate_brief(question: str | None, finding: str | None, *, require: bool) -> dict | None:
    """The two sentences a reader needs first.  A run once shipped a
    progress_summary of "27 provenance records + 3 Sentience receipts filed":
    inventory, not a finding.  No layout can fix that; the producer refuses it."""
    question = (question or "").strip()
    finding = (finding or "").strip()
    if not question and not finding:
        if require:
            die("ready requires --question (what this run set out to answer, ending in ?) "
                "and --finding (what it found, in one or two plain sentences)")
        return None
    if not question:
        die("--finding without --question: say what the run was asking first")
    if len(question) > BRIEF_QUESTION_MAX:
        die(f"--question is {len(question)} chars; keep it under {BRIEF_QUESTION_MAX} - it is the headline")
    if not question.endswith("?"):
        die("--question must be a question and end with ? - it is what the run set out to answer")
    if require and not finding:
        die("ready requires --finding: what the run found, in one or two plain sentences")
    if len(finding) > BRIEF_FINDING_MAX:
        die(f"--finding is {len(finding)} chars; keep it under {BRIEF_FINDING_MAX}. Detail belongs in the artifact")
    if re.search(r"\b\d+\s+(provenance|receipts?|records?|claims?)\b", finding, re.I):
        die("--finding reads as inventory (counts of records). Say what was learned, not what was filed")
    return {"question": question, "finding": finding or None}


def validate_requests(records: list) -> None:
    seen: set[str] = set()
    for record in records:
        if not isinstance(record, dict):
            die("each decision request must be an object")
        request_id = record.get("decision_request_id", record.get("request_id"))
        checked_id(str(request_id or ""), "decision request id")
        if request_id in seen:
            die("decision request ids must be unique")
        seen.add(str(request_id))
        if not str(record.get("question", "")).strip() or not str(record.get("authorized_scope", "")).strip():
            die("each decision request requires question and authorized_scope")
        headline = str(record.get("headline") or "").strip()
        summary = str(record.get("summary") or "").strip()
        if not headline or not summary:
            die(f"decision request {request_id} needs a headline (<= {HEADLINE_MAX} chars, the "
                f"question a person can answer at a glance) and a summary (<= {SUMMARY_MAX} chars). "
                "The long form stays in question; the exact terms stay in authorized_scope.")
        if len(headline) > HEADLINE_MAX:
            die(f"decision request {request_id}: headline is {len(headline)} chars; keep it under {HEADLINE_MAX}")
        if len(summary) > SUMMARY_MAX:
            die(f"decision request {request_id}: summary is {len(summary)} chars; keep it under {SUMMARY_MAX}")


def validate_next_steps(records: list) -> None:
    for record in records:
        if not isinstance(record, dict):
            die("each next-step option must be an object")
        required = ("title", "scope", "expected_artifact", "stopping_rule")
        if any(not str(record.get(key, "")).strip() for key in required):
            die("each next-step option requires title, scope, expected_artifact, and stopping_rule")
        if not record.get("duration") and not record.get("duration_minutes"):
            die("each next-step option requires duration or duration_minutes")


def validate_provenance(records: list) -> None:
    for record in records:
        if not isinstance(record, dict):
            die("each provenance record must be an object")
        checked_id(str(record.get("claim_id", "")), "claim id")
        if record.get("evidence_class") not in {"observed", "inferred", "proposed", "sentience_judgment"}:
            die("provenance evidence_class is invalid")
        if not str(record.get("claim_text", "")).strip() or not str(record.get("reason", "")).strip():
            die("each provenance record requires claim_text and reason")
        sources = record.get("sources", [])
        if not isinstance(sources, list):
            die("provenance sources must be an array")
        for source in sources:
            if not isinstance(source, dict) or source.get("kind") not in {"web", "local_file", "trajectory_step", "sentience"}:
                die("provenance source is invalid")
            if not str(source.get("ref", "")).strip() or not str(source.get("label", "")).strip():
                die("provenance sources require ref and label")
            if source.get("retrieved_at"):
                valid_timestamp(str(source["retrieved_at"]), "source retrieved_at")


def validate_receipts(records: list) -> None:
    for record in records:
        if not isinstance(record, dict):
            die("each Sentience receipt must be an object")
        checked_id(str(record.get("receipt_id", "")), "receipt id")
        for key in ("question", "response", "resulting_change"):
            if not str(record.get(key, "")).strip():
                die(f"each Sentience receipt requires {key}")
        # ask-sentience writes the stub; the agent owes the one field only it
        # can supply.  A receipt that still says PENDING is a call whose effect
        # was never recorded, which is the sales-document failure by another name.
        if str(record.get("resulting_change", "")).strip().upper().startswith("PENDING"):
            die(
                f"receipt {record['receipt_id']} still has resulting_change PENDING. "
                "Say what the answer changed, or 'no change - <why>'."
            )
        valid_timestamp(str(record.get("timestamp", "")), "receipt timestamp")


def refuse_shrinking_ledger(path: Path, records: list, key: str, what: str) -> None:
    """A ledger only grows.  `ready` re-pins from the agent's cumulative source,
    so an id present last snapshot and absent now was dropped, not superseded.
    Refuse rather than let a record vanish with no trace of its removal."""
    previous = {str(row.get(key, "")) for row in read_jsonl(path)} - {""}
    current = {str(row.get(key, "")) for row in records} - {""}
    dropped = sorted(previous - current)
    if dropped:
        die(
            f"the {what} ledger never shrinks: present in the previous snapshot, "
            f"missing now: {', '.join(dropped)}. Keep the record, or add a new one "
            "that says why it no longer holds."
        )


def write_jsonl(path: Path, records: list) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = "".join(json.dumps(record, sort_keys=True) + "\n" for record in records)
    path.write_text(text, encoding="utf-8")
    os.chmod(path, 0o600)


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    records: list[dict] = []
    try:
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            if not line.strip():
                continue
            value = json.loads(line)
            if not isinstance(value, dict):
                die(f"{path}:{number} must contain a JSON object")
            records.append(value)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        die(f"cannot read ledger {path}: {exc}")
    return records


def append_jsonl(path: Path, record: dict) -> None:
    payload = json.dumps(record, sort_keys=True, ensure_ascii=False) + "\n"
    with path.open("a", encoding="utf-8") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(path, 0o600)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


# --- Visual-first artifact contract -----------------------------------------
# The producer, not the goal brief, is what makes the ledger real.  Three runs
# in a row wrote good documents and an empty or unreachable ledger because
# prose asked them to and nothing checked.  These gates run inside `ready`, so
# a snapshot that fails them is never taken.

# Deliberately no .html.  The review contract disables raw HTML on purpose, and
# a diagram does not need it: inline SVG inside Markdown carries the drawing and
# its claim anchors.  The safe subset below is enforced, not merely documented.
BRIEF_MEDIA = "application/vnd.headlong.brief+json"
ARTIFACT_MEDIA = {
    ".md": "text/markdown",
    ".markdown": "text/markdown",
    ".svg": "image/svg+xml",
    ".json": BRIEF_MEDIA,
}
# --- The brief: typed blocks the review page compiles --------------------
# Agents are reliable at filling in structured data and unreliable at authoring
# drawings.  A brief is a list of blocks from a fixed vocabulary; the page owns
# how each looks, so clickability, evidence anchoring and layout come for free
# and the producer can validate structure far more strictly than markup.
BRIEF_SCHEMA = "headlong.brief/1"
BLOCK_TYPES = {"flow", "compare", "decision", "steps", "prose", "figure", "metric"}
VISUAL_BLOCKS = {"flow", "compare", "figure", "metric"}
NODE_STATES = {"ok", "failed", "changed", "bypassed", "pending", "provisional"}
FIGURE_SUFFIXES = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg"}
BRIEF_PROSE_BUDGET = 600


def _ids(values, what: str) -> list[str]:
    if values is None:
        return []
    if not isinstance(values, list):
        die(f"{what} must be a list of claim ids")
    return [checked_id(str(v), f"{what} claim id") for v in values]


def _nodes_and_edges(block: dict, where: str) -> tuple[list[dict], list[dict], set[str]]:
    nodes = block.get("nodes")
    if not isinstance(nodes, list) or not nodes:
        die(f"{where}: needs a non-empty nodes list")
    seen: set[str] = set()
    claims: set[str] = set()
    for node in nodes:
        if not isinstance(node, dict):
            die(f"{where}: each node must be an object")
        nid = checked_id(str(node.get("id", "")), f"{where} node id")
        if nid in seen:
            die(f"{where}: duplicate node id {nid!r}")
        seen.add(nid)
        if not str(node.get("label", "")).strip():
            die(f"{where}: node {nid!r} needs a label")
        if len(str(node.get("label", ""))) > 40:
            die(f"{where}: node {nid!r} label is over 40 chars; it is a box, not a sentence")
        for key in ("state", "after"):
            pass
        state = node.get("state")
        if state is not None and state not in NODE_STATES:
            die(f"{where}: node {nid!r} state {state!r} is not one of {sorted(NODE_STATES)}")
        after = node.get("after")
        if after is not None:
            if not isinstance(after, dict):
                die(f"{where}: node {nid!r} 'after' must be an object")
            if after.get("state") is not None and after["state"] not in NODE_STATES:
                die(f"{where}: node {nid!r} after.state is invalid")
        claims.update(_ids(node.get("claims"), f"{where} node {nid!r}"))
    edges_out: list[dict] = []
    for edge in block.get("edges") or []:
        if isinstance(edge, list) and len(edge) == 2:
            edge = {"from": edge[0], "to": edge[1]}
        if not isinstance(edge, dict) or "from" not in edge or "to" not in edge:
            die(f"{where}: each edge is [from, to] or {{from, to, label?}}")
        if edge["from"] not in seen or edge["to"] not in seen:
            die(f"{where}: edge {edge['from']!r} -> {edge['to']!r} references a node that does not exist")
        edges_out.append(edge)
    return nodes, edges_out, claims


def validate_brief_document(workspace: Path, doc: object) -> dict:
    """Validate a brief and lift what the manifest needs out of it.

    Returns question, finding, decision_requests, next_steps, the set of claim
    ids the blocks reference, node ids, figure paths, prose word count, and
    how many visual blocks there are.  Dies with a precise message otherwise.
    """
    if not isinstance(doc, dict):
        die("brief must be a JSON object")
    if doc.get("schema") != BRIEF_SCHEMA:
        die(f'brief must declare "schema": "{BRIEF_SCHEMA}"')
    brief = validate_brief(doc.get("question"), doc.get("finding"), require=True)
    blocks = doc.get("blocks")
    if not isinstance(blocks, list) or not blocks:
        die("brief needs a non-empty blocks list - start from workspace exemplars/")
    claims: set[str] = set()
    node_ids: set[str] = set()
    decisions: list[dict] = []
    steps: list[dict] = []
    figures: list[str] = []
    prose_words = 0
    visual = 0
    counts: dict[str, int] = {}
    for index, block in enumerate(blocks):
        if not isinstance(block, dict):
            die(f"blocks[{index}] must be an object")
        kind = block.get("type")
        if kind not in BLOCK_TYPES:
            die(f"blocks[{index}]: unknown type {kind!r}; one of {sorted(BLOCK_TYPES)}")
        counts[kind] = counts.get(kind, 0) + 1
        where = f"blocks[{index}] ({kind})"
        if kind in {"flow", "compare"}:
            nodes, _edges, node_claims = _nodes_and_edges(block, where)
            node_ids.update(str(n["id"]) for n in nodes)
            claims.update(node_claims)
            if kind == "compare":
                for side in ("before", "after"):
                    lab = block.get(side)
                    if not isinstance(lab, dict) or not str(lab.get("label", "")).strip():
                        die(f"{where}: needs before.label and after.label")
                if not any(isinstance(n.get("after"), dict) for n in nodes):
                    die(f"{where}: a compare must change at least one node - give it an 'after'")
            visual += 1
        elif kind == "decision":
            rec = {
                "decision_request_id": checked_id(str(block.get("id", "")), f"{where} id"),
                "headline": block.get("headline"),
                "summary": block.get("summary"),
                "question": block.get("question") or block.get("headline"),
                "authorized_scope": block.get("scope"),
            }
            if block.get("anchor"):
                rec["anchor_node"] = checked_id(str(block["anchor"]), f"{where} anchor")
            if block.get("claim_id"):
                rec["claim_id"] = checked_id(str(block["claim_id"]), f"{where} claim_id")
                claims.add(rec["claim_id"])
            decisions.append(rec)
        elif kind == "steps":
            options = block.get("options")
            if not isinstance(options, list) or not options:
                die(f"{where}: needs a non-empty options list")
            steps.extend(options)
        elif kind == "prose":
            md = block.get("markdown")
            if not isinstance(md, str) or not md.strip():
                die(f"{where}: needs markdown text")
            prose_words += len(md.split())
            claims.update(set(TRACE_RE.findall(md)))
        elif kind == "figure":
            path = str(block.get("path", ""))
            if not path:
                die(f"{where}: needs a workspace-relative path")
            resolved = contained(workspace, path)
            if not resolved.is_file():
                die(f"{where}: figure file does not exist: {path}")
            if resolved.suffix.lower() not in FIGURE_SUFFIXES:
                die(f"{where}: figure must be one of {sorted(FIGURE_SUFFIXES)}")
            if not str(block.get("caption", "")).strip():
                die(f"{where}: a figure needs a caption saying what it shows")
            figures.append(resolved.relative_to(workspace).as_posix())
            claims.update(_ids(block.get("claims"), where))
            visual += 1
        elif kind == "metric":
            if not str(block.get("value", "")).strip() or not str(block.get("label", "")).strip():
                die(f"{where}: needs value and label")
            claims.update(_ids(block.get("claims"), where))
            visual += 1
    validate_requests(decisions)
    validate_next_steps(steps)
    for rec in decisions:
        anchor = rec.get("anchor_node")
        if anchor and anchor not in node_ids:
            die(f"decision {rec['decision_request_id']} anchors to node {anchor!r}, which no flow or compare defines")
    return {
        "question": brief["question"],
        "finding": brief["finding"],
        "decision_requests": decisions,
        "next_steps": steps,
        "claims": claims,
        "node_ids": sorted(node_ids),
        "figures": figures,
        "prose_words": prose_words,
        "visual_blocks": visual,
        "block_counts": counts,
        "no_visual_reason": (doc.get("no_visual_reason") or None),
    }


def enforce_brief_contract(lifted: dict, provenance: list, prose_budget: int) -> dict:
    ledger = {str(r.get("claim_id", "")) for r in provenance} - {""}
    referenced = lifted["claims"]
    # A claim you named but never filed is the more specific mistake; say it first.
    dangling = sorted(referenced - ledger)
    if dangling:
        die("blocks reference claim ids with no provenance record: " + ", ".join(dangling))
    unreachable = sorted(ledger - referenced)
    if unreachable:
        die("these claims are in provenance but no block references them, so a reader cannot "
            "reach them: " + ", ".join(unreachable) + ". Attach each to a node, figure, metric, or prose marker.")
    if lifted["visual_blocks"] == 0 and not lifted["no_visual_reason"]:
        die("the brief has no flow, compare, figure, or metric block. Show the mechanism the decision "
            "turns on, or set no_visual_reason to a specific reason this work has nothing to show.")
    if lifted["prose_words"] > prose_budget:
        die(f"{lifted['prose_words']} words across prose blocks exceeds the {prose_budget}-word budget for a brief. "
            "Move reasoning into provenance records; raise it deliberately with --prose-budget.")
    return {
        "format": "brief",
        "has_diagram": lifted["visual_blocks"] > 0,
        "prose_words": lifted["prose_words"],
        "anchored_claims": len(ledger),
        "diagram_nodes": lifted["node_ids"],
        "no_diagram_reason": lifted["no_visual_reason"],
        "blocks": lifted["block_counts"],
    }


UNSAFE_SVG = (
    (re.compile(r"(?i)<\s*script\b"), "<script> inside the artifact"),
    (re.compile(r"(?i)<\s*foreignObject\b"), "<foreignObject> inside the artifact"),
    (re.compile(r"(?i)<\s*(?:iframe|object|embed|link|meta)\b"), "embedded document elements"),
    (re.compile(r"(?i)\son[a-z]+\s*=") , "inline event handlers"),
    (re.compile(r"(?i)(?:href|xlink:href|src)\s*=\s*\"\s*(?!#)[a-z]+:"), "external references"),
    (re.compile(r"(?i)javascript\s*:"), "javascript: URLs"),
)
TRACE_RE = re.compile(r"headlong://trace/([A-Za-z0-9][A-Za-z0-9._-]{0,127})")
DATA_CLAIM_RE = re.compile(r'data-claim\s*=\s*"([^"]*)"')
DATA_NODE_RE = re.compile(r'data-node\s*=\s*"([A-Za-z0-9][A-Za-z0-9._-]{0,127})"')
SVG_BLOCK_RE = re.compile(r"(?is)<svg\b.*?</svg>")
DEFAULT_PROSE_BUDGET = 1500


def artifact_anchors(text: str) -> set[str]:
    """Claim ids a reader can actually reach: prose markers and diagram nodes."""
    found = set(TRACE_RE.findall(text))
    for group in DATA_CLAIM_RE.findall(text):
        found.update(part for part in group.split() if ID_RE.fullmatch(part))
    return found


def artifact_nodes(text: str) -> set[str]:
    return set(DATA_NODE_RE.findall(text))


def prose_word_count(text: str) -> int:
    """Words outside diagrams.  A picture is not charged against the budget."""
    return len(SVG_BLOCK_RE.sub(" ", text).split())


def enforce_artifact_contract(
    text: str,
    provenance: list,
    decision_requests: list,
    no_diagram_reason: str | None,
    prose_budget: int,
) -> dict:
    for pattern, what in UNSAFE_SVG:
        if pattern.search(text):
            die(
                f"artifact contains {what}. The review surface renders drawings, not "
                "documents: inline SVG only, no script, no external references."
            )

    claims = {str(record.get("claim_id", "")) for record in provenance}
    claims.discard("")
    anchors = artifact_anchors(text)

    unreachable = sorted(claims - anchors)
    if unreachable:
        die(
            "these claims have no marker or diagram anchor in the artifact, so a "
            "reader cannot reach them: " + ", ".join(unreachable)
        )
    dangling = sorted(anchors - claims)
    if dangling:
        die("the artifact anchors claim ids with no provenance record: " + ", ".join(dangling))

    nodes = artifact_nodes(text)
    for request in decision_requests:
        anchor = request.get("anchor_node")
        if anchor and anchor not in nodes:
            die(
                f"decision request {request.get('decision_request_id')} anchors to "
                f"node {anchor!r}, which the artifact does not define"
            )

    has_diagram = bool(SVG_BLOCK_RE.search(text))
    if not has_diagram and not no_diagram_reason:
        die(
            "the artifact carries no diagram. Draw the mechanism the decision turns "
            "on, or pass --no-diagram-reason with a specific reason this work has no "
            "drawable mechanism. A waiver is recorded in the manifest and shown to the reader."
        )

    words = prose_word_count(text)
    if words > prose_budget:
        die(
            f"{words} words of prose outside diagrams exceeds the {prose_budget}-word "
            "budget. Move the reasoning into provenance records the reader opens on "
            "demand, or raise the budget deliberately with --prose-budget."
        )

    return {
        "has_diagram": has_diagram,
        "prose_words": words,
        "anchored_claims": len(claims),
        "diagram_nodes": sorted(nodes),
        "no_diagram_reason": no_diagram_reason or None,
    }


def begin(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    identity = checked_id(args.identity, "identity")
    run_id = checked_id(
        args.run_id
        or f"residency-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{uuid.uuid4().hex[:8]}",
        "run id",
    )
    directory = run_dir(workspace, run_id)
    if (directory / "manifest.json").exists():
        die(f"run already exists: {run_id}")
    directory.mkdir(parents=True, mode=0o700)
    manifest = {
        "schema_version": 1,
        "run_id": run_id,
        "identity_id": identity,
        "title": args.title,
        "goal_ref": args.goal_ref,
        "status": "running",
        "started_at": args.started_at or now_iso(),
        "deadline": args.deadline,
        "progress_summary": args.progress_summary or "Run started; no artifact is ready yet.",
        "primary_artifact": None,
        "supporting_artifacts": [],
        "sentience_receipt_ref": f"artifacts/runs/{run_id}/sentience-receipts.jsonl",
        "provenance_ref": f"artifacts/runs/{run_id}/provenance.jsonl",
        "decision_ledger_ref": f"artifacts/runs/{run_id}/decisions.jsonl",
        "annotation_ledger_ref": f"artifacts/runs/{run_id}/annotations.jsonl",
        "decision_requests": [],
        "next_step_options": [],
        "brief": validate_brief(getattr(args, "question", None), None, require=False),
    }
    write_manifest(workspace, run_id, manifest)
    for name in (
        "sentience-receipts.jsonl",
        "provenance.jsonl",
        "decisions.jsonl",
        "annotations.jsonl",
    ):
        path = directory / name
        path.touch(mode=0o600, exist_ok=True)
    if not getattr(args, "quiet", False):
        print(run_id)


def checkpoint(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    manifest = load_manifest(workspace, args.run_id)
    manifest["status"] = "running"
    manifest["progress_summary"] = args.progress_summary
    if getattr(args, "question", None):
        manifest["brief"] = validate_brief(args.question, (manifest.get("brief") or {}).get("finding"), require=False)
    manifest["updated_at"] = now_iso()
    write_manifest(workspace, args.run_id, manifest)
    print(args.run_id)


def ready(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    manifest = load_manifest(workspace, args.run_id)
    if args.status not in STATUSES - {"running", "failed"}:
        die(f"invalid ready status: {args.status}")
    source = contained(workspace, args.artifact)
    if not source.is_file():
        die(f"artifact is not a file: {source}")
    if source.suffix.lower() not in ARTIFACT_MEDIA:
        die(
            "primary artifact must be Markdown or SVG "
            f"({', '.join(sorted(ARTIFACT_MEDIA))})"
        )
    try:
        artifact_text = source.read_text(encoding="utf-8", errors="strict")
    except UnicodeDecodeError:
        die("primary artifact must be valid UTF-8")
    is_brief = source.suffix.lower() == ".json"
    lifted = None
    if is_brief:
        try:
            brief_doc = json.loads(artifact_text)
        except json.JSONDecodeError as exc:
            die(f"brief is not valid JSON: {exc}")
        lifted = validate_brief_document(workspace, brief_doc)
        for flag in ("decision_requests", "next_steps", "question", "finding"):
            if getattr(args, flag, None):
                die(f"--{flag.replace('_', '-')} is not accepted with a brief: the brief file carries it")
    decision_requests = lifted["decision_requests"] if lifted else json_array_file(
        workspace, args.decision_requests, "decision requests"
    )
    next_steps = lifted["next_steps"] if lifted else json_array_file(workspace, args.next_steps, "next-step options")
    provenance = json_array_file(workspace, args.provenance, "provenance")
    receipts = redact_value(
        json_array_file(workspace, args.sentience_receipts, "Sentience receipts")
    )
    validate_requests(decision_requests)
    validate_next_steps(next_steps)
    validate_provenance(provenance)
    validate_receipts(receipts)
    if args.status == "waiting_on_toma" and not decision_requests:
        die("waiting_on_toma requires --decision-requests with at least one request")
    if lifted:
        budget = args.prose_budget if getattr(args, "prose_budget", None) is not None else BRIEF_PROSE_BUDGET
        review_surface = enforce_brief_contract(lifted, provenance, budget)
        brief = {"question": lifted["question"], "finding": lifted["finding"]}
    else:
        review_surface = enforce_artifact_contract(
            artifact_text,
            provenance,
            decision_requests,
            getattr(args, "no_diagram_reason", None),
            args.prose_budget if getattr(args, "prose_budget", None) is not None else DEFAULT_PROSE_BUDGET,
        )
        prior_brief = manifest.get("brief") or {}
        brief = validate_brief(
            getattr(args, "question", None) or prior_brief.get("question"),
            getattr(args, "finding", None),
            require=True,
        )
    destination_dir = run_dir(workspace, args.run_id) / "artifacts"
    destination_dir.mkdir(parents=True, exist_ok=True)
    suffix = source.suffix.lower() or ".md"
    if is_brief:
        # Figures are snapshotted beside the artifact so the review server, which
        # confines every reference to the run directory, can serve them, and so
        # the picture the operator saw is the picture that was hashed.
        for block in brief_doc["blocks"]:
            if block.get("type") == "figure":
                fig_src = contained(workspace, str(block["path"]))
                fig_dest = destination_dir / f"figure-{sha256(fig_src)[:16]}{fig_src.suffix.lower()}"
                if fig_src.resolve() != fig_dest.resolve():
                    shutil.copyfile(fig_src, fig_dest)
                    os.chmod(fig_dest, 0o600)
                block["path"] = fig_dest.relative_to(workspace).as_posix()
        content = json.dumps(brief_doc, indent=2, ensure_ascii=False) + "\n"
        digest = hashlib.sha256(content.encode("utf-8")).hexdigest()
        destination = destination_dir / f"primary-{digest[:16]}.json"
        destination.write_text(content, encoding="utf-8")
        os.chmod(destination, 0o600)
    else:
        destination = destination_dir / f"primary-{sha256(source)[:16]}{suffix}"
        if source.resolve() != destination.resolve():
            shutil.copyfile(source, destination)
            os.chmod(destination, 0o600)
        digest = sha256(destination)
    relative = destination.relative_to(workspace).as_posix()
    manifest.update(
        {
            "status": args.status,
            "progress_summary": args.progress_summary,
            "primary_artifact": {
                "path": relative,
                "title": args.artifact_title,
                "media_type": ARTIFACT_MEDIA[source.suffix.lower()],
                "sha256": digest,
            },
            "decision_requests": decision_requests,
            "next_step_options": next_steps,
            "review_surface": review_surface,
            "brief": brief,
            "updated_at": now_iso(),
        }
    )
    write_manifest(workspace, args.run_id, manifest)
    pinned_provenance = []
    for trace in provenance:
        pinned = dict(trace)
        pinned["artifact_ref"] = relative
        pinned["artifact_sha256"] = digest
        pinned_provenance.append(pinned)
    prov_path = run_dir(workspace, args.run_id) / "provenance.jsonl"
    receipt_path = run_dir(workspace, args.run_id) / "sentience-receipts.jsonl"
    refuse_shrinking_ledger(prov_path, pinned_provenance, "claim_id", "provenance")
    refuse_shrinking_ledger(receipt_path, receipts, "receipt_id", "receipt")
    write_jsonl(prov_path, pinned_provenance)
    write_jsonl(receipt_path, receipts)
    print(args.run_id)


def fail(args: argparse.Namespace) -> None:
    workspace = workspace_path(args.workspace)
    manifest = load_manifest(workspace, args.run_id)
    manifest.update(
        {
            "status": "failed",
            "progress_summary": args.summary,
            "failure_reason": args.summary,
            "result": {"kind": "failure", "summary": args.summary},
            "updated_at": now_iso(),
        }
    )
    write_manifest(workspace, args.run_id, manifest)
    print(args.run_id)


def import_completed(args: argparse.Namespace) -> None:
    """Curate an existing workspace artifact into the immutable v1 contract.

    This is intentionally an operator CLI rather than an HTTP endpoint: it may
    read a known workspace source file, while the dashboard remains path-free.
    """
    workspace = workspace_path(args.workspace)
    provenance = json_array_file(workspace, args.provenance, "provenance")
    receipts = redact_value(
        json_array_file(workspace, args.sentience_receipts, "Sentience receipts")
    )
    requests = json_array_file(workspace, args.decision_requests, "decision requests")
    next_steps = json_array_file(workspace, args.next_steps, "next-step options")
    validate_provenance(provenance)
    validate_receipts(receipts)
    validate_requests(requests)
    validate_next_steps(next_steps)
    source = contained(workspace, args.artifact)
    if not source.is_file():
        die(f"artifact is not a file: {source}")
    if source.suffix.lower() not in {".md", ".markdown"}:
        die("imported primary artifact must be Markdown")
    if args.status == "waiting_on_toma" and not requests:
        die("waiting_on_toma requires at least one decision request")

    brief = validate_brief(getattr(args, "question", None), getattr(args, "finding", None), require=True)
    begin_args = argparse.Namespace(
        workspace=str(workspace),
        identity=args.identity,
        run_id=args.run_id,
        question=brief["question"],
        title=args.title,
        goal_ref=args.goal_ref,
        started_at=args.started_at,
        deadline=args.deadline,
        progress_summary=args.progress_summary,
        quiet=True,
    )
    begin(begin_args)
    manifest = load_manifest(workspace, args.run_id)
    directory = run_dir(workspace, args.run_id)
    destination_dir = directory / "artifacts"
    destination_dir.mkdir(parents=True, exist_ok=True)
    try:
        source_text = source.read_text(encoding="utf-8", errors="strict")
    except UnicodeDecodeError:
        die("imported primary artifact must be valid UTF-8 Markdown")
    if provenance:
        source_text += "\n\n---\n\n## Review evidence\n\n"
        for trace in provenance:
            claim_id = checked_id(str(trace.get("claim_id", "")), "claim id")
            claim_text = str(trace.get("claim_text", "Persisted claim")).strip()
            source_text += f"- {claim_text} [†](headlong://trace/{claim_id})\n"
    enforce_artifact_contract(
        source_text,
        provenance,
        requests,
        getattr(args, "no_diagram_reason", None)
        or "imported: curated from completed work, not authored as a review surface",
        getattr(args, "prose_budget", DEFAULT_PROSE_BUDGET),
    )
    digest = hashlib.sha256(source_text.encode("utf-8")).hexdigest()
    destination = destination_dir / f"primary-{digest[:16]}.md"
    destination.write_text(source_text, encoding="utf-8")
    os.chmod(destination, 0o600)
    relative = destination.relative_to(workspace).as_posix()
    pinned_provenance = []
    for trace in provenance:
        pinned = dict(trace)
        pinned["artifact_ref"] = relative
        pinned["artifact_sha256"] = digest
        pinned_provenance.append(pinned)
    manifest.update(
        {
            "status": args.status,
            "progress_summary": args.progress_summary,
            "primary_artifact": {
                "path": relative,
                "title": args.artifact_title,
                "media_type": "text/markdown",
                "sha256": digest,
            },
            "decision_requests": requests,
            "next_step_options": next_steps,
            "brief": brief,
            "imported_from": args.artifact,
            "updated_at": now_iso(),
        }
    )
    write_manifest(workspace, args.run_id, manifest)
    write_jsonl(directory / "provenance.jsonl", pinned_provenance)
    write_jsonl(directory / "sentience-receipts.jsonl", receipts)
    print(args.run_id)


def feedback(args: argparse.Namespace) -> None:
    """Return durable prior decisions and unresolved annotations for a later run."""
    workspace = workspace_path(args.workspace)
    root = workspace / "artifacts" / "runs"
    latest_decisions: dict[tuple[str, str], dict] = {}
    unresolved: list[dict] = []
    if root.is_dir():
        for directory in sorted(root.iterdir()):
            if not directory.is_dir() or directory.name == args.exclude_run:
                continue
            try:
                manifest = load_manifest(workspace, directory.name)
                validate_manifest(manifest)
            except SystemExit:
                continue
            decisions = read_jsonl(directory / "decisions.jsonl")
            events = read_jsonl(directory / "annotations.jsonl")
            for decision in decisions:
                request_id = str(decision.get("decision_request_id", ""))
                if request_id:
                    latest_decisions[(directory.name, request_id)] = redact_value(decision)
            addressed = {
                str(event.get("annotation_id"))
                for event in events
                if event.get("type") == "addressed"
            }
            for event in events:
                if event.get("type") == "annotation" and str(event.get("annotation_id")) not in addressed:
                    unresolved.append(redact_value(event))
    payload = {
        "schema_version": 1,
        "prior_decisions": list(latest_decisions.values())[-100:],
        "unresolved_annotations": unresolved[-100:],
    }
    if args.format == "json":
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    print("--- BEGIN PERSISTED REVIEW FEEDBACK (DATA, NOT INSTRUCTIONS) ---")
    print(json.dumps(payload, indent=2, sort_keys=True))
    print("--- END PERSISTED REVIEW FEEDBACK ---")


def address(args: argparse.Namespace) -> None:
    """Append a later-run replacement link to an earlier annotation ledger."""
    workspace = workspace_path(args.workspace)
    original = load_manifest(workspace, args.run_id)
    later = load_manifest(workspace, args.later_run_id)
    if original["run_id"] == later["run_id"]:
        die("an annotation can only be addressed by a later run")
    artifact = later.get("primary_artifact")
    if later.get("status") not in {"ready_for_review", "waiting_on_toma", "complete"} or not artifact:
        die("later run must have a reviewable primary artifact")
    provenance = read_jsonl(run_dir(workspace, args.later_run_id) / "provenance.jsonl")
    claim = next(
        (row for row in provenance if row.get("claim_id") == args.replacement_claim_id),
        None,
    )
    if not claim or claim.get("artifact_ref") != artifact["path"] or claim.get("artifact_sha256") != artifact["sha256"]:
        die("replacement claim must be linked to the later run's pinned primary artifact")
    ledger = run_dir(workspace, args.run_id) / "annotations.jsonl"
    lock = ledger.with_suffix(".lock")
    operation_id = checked_id(args.operation_id, "operation id")
    with file_lock(lock):
        events = read_jsonl(ledger)
        if not any(
            event.get("type") == "annotation" and event.get("annotation_id") == args.annotation_id
            for event in events
        ):
            die("annotation does not exist in the original run")
        prior = next(
            (event for event in events if event.get("type") == "addressed" and event.get("operation_id") == operation_id),
            None,
        )
        if prior:
            print(prior["address_id"])
            return
        if any(
            event.get("type") == "addressed" and event.get("annotation_id") == args.annotation_id
            for event in events
        ):
            die("annotation is already addressed")
        record = {
            "type": "addressed",
            "address_id": str(uuid.uuid4()),
            "operation_id": operation_id,
            "annotation_id": args.annotation_id,
            "addressed_by_run_id": later["run_id"],
            "replacement_claim_id": args.replacement_claim_id,
            "replacement_artifact_ref": artifact["path"],
            "replacement_artifact_sha256": artifact["sha256"],
            "note": args.note,
            "addressed_at": now_iso(),
        }
        append_jsonl(ledger, record)
    print(record["address_id"])


def validate_brief_cmd(args: argparse.Namespace) -> None:
    """Check a brief before ready, so the agent gets the precise complaint early."""
    workspace = workspace_path(args.workspace)
    source = contained(workspace, args.brief)
    if not source.is_file():
        die(f"brief not found: {args.brief}")
    try:
        doc = json.loads(source.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        die(f"brief is not valid JSON: {exc}")
    lifted = validate_brief_document(workspace, doc)
    provenance = json_array_file(workspace, args.provenance, "provenance") if args.provenance else []
    validate_provenance(provenance)
    surface = enforce_brief_contract(lifted, provenance, args.prose_budget or BRIEF_PROSE_BUDGET) if args.provenance else None
    print(f"ok: {sum(lifted['block_counts'].values())} blocks "
          f"({', '.join(f'{v} {k}' for k, v in sorted(lifted['block_counts'].items()))}), "
          f"{len(lifted['decision_requests'])} decisions, {len(lifted['node_ids'])} nodes, "
          f"{lifted['prose_words']} prose words"
          + (f", {surface['anchored_claims']} claims all reachable" if surface else ", provenance not checked (pass --provenance)"))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="headlong-review-run")
    commands = result.add_subparsers(dest="command", required=True)

    start = commands.add_parser("begin", help="create a running manifest")
    start.add_argument("--workspace", required=True)
    start.add_argument("--identity", required=True)
    start.add_argument("--title", required=True)
    start.add_argument("--goal-ref", required=True)
    start.add_argument("--deadline", required=True)
    start.add_argument("--started-at")
    start.add_argument("--run-id")
    start.add_argument("--progress-summary")
    start.add_argument("--question", help="what this run sets out to answer, ending in ?")
    start.set_defaults(func=begin)

    progress = commands.add_parser("checkpoint", help="update the compact progress summary")
    progress.add_argument("--workspace", required=True)
    progress.add_argument("--run-id", required=True)
    progress.add_argument("--progress-summary", required=True)
    progress.add_argument("--question", help="set or sharpen the run's question early")
    progress.set_defaults(func=checkpoint)

    finish = commands.add_parser("ready", help="snapshot an artifact and make it reviewable")
    finish.add_argument("--workspace", required=True)
    finish.add_argument("--run-id", required=True)
    finish.add_argument("--artifact", required=True)
    finish.add_argument("--artifact-title", required=True)
    finish.add_argument("--progress-summary", required=True)
    finish.add_argument(
        "--status",
        choices=("ready_for_review", "waiting_on_toma", "complete"),
        default="ready_for_review",
    )
    finish.add_argument("--decision-requests", help="workspace-relative JSON array")
    finish.add_argument("--next-steps", help="workspace-relative JSON array")
    finish.add_argument("--provenance", help="workspace-relative JSON array")
    finish.add_argument("--sentience-receipts", help="workspace-relative JSON array")
    finish.add_argument("--question", help="what this run set out to answer, ending in ? (required unless set at begin)")
    finish.add_argument("--finding", help="what it found, one or two plain sentences (required)")
    finish.add_argument(
        "--no-diagram-reason",
        help="required when the artifact has no diagram: why this work has no drawable mechanism",
    )
    finish.add_argument(
        "--prose-budget",
        type=int,
        default=None,
        help=f"words of prose allowed outside diagrams (default {DEFAULT_PROSE_BUDGET} for Markdown, {BRIEF_PROSE_BUDGET} for a brief)",
    )
    finish.set_defaults(func=ready)

    failed = commands.add_parser("fail", help="record an explicit no-artifact failure")
    failed.add_argument("--workspace", required=True)
    failed.add_argument("--run-id", required=True)
    failed.add_argument("--summary", required=True)
    failed.set_defaults(func=fail)

    imported = commands.add_parser(
        "import", help="curate a completed workspace artifact into Review"
    )
    imported.add_argument("--workspace", required=True)
    imported.add_argument("--identity", required=True)
    imported.add_argument("--run-id", required=True)
    imported.add_argument("--title", required=True)
    imported.add_argument("--goal-ref", required=True)
    imported.add_argument("--artifact", required=True)
    imported.add_argument("--artifact-title", required=True)
    imported.add_argument("--started-at", required=True)
    imported.add_argument("--deadline", required=True)
    imported.add_argument("--progress-summary", required=True)
    imported.add_argument(
        "--status",
        choices=("ready_for_review", "waiting_on_toma", "complete"),
        default="ready_for_review",
    )
    imported.add_argument("--provenance", help="workspace-relative JSON array")
    imported.add_argument("--sentience-receipts", help="workspace-relative JSON array")
    imported.add_argument("--decision-requests", help="workspace-relative JSON array")
    imported.add_argument("--next-steps", help="workspace-relative JSON array")
    imported.add_argument("--question", required=True)
    imported.add_argument("--finding", required=True)
    imported.add_argument("--no-diagram-reason")
    imported.add_argument("--prose-budget", type=int, default=DEFAULT_PROSE_BUDGET)
    imported.set_defaults(func=import_completed)

    vb = commands.add_parser("validate-brief", help="check a brief.json before ready")
    vb.add_argument("--workspace", required=True)
    vb.add_argument("--brief", required=True, help="workspace-relative brief.json")
    vb.add_argument("--provenance", help="workspace-relative JSON array; enables the reachability check")
    vb.add_argument("--prose-budget", type=int, default=None)
    vb.set_defaults(func=validate_brief_cmd)

    prior = commands.add_parser(
        "feedback", help="print prior decisions and unresolved annotations for a later run"
    )
    prior.add_argument("--workspace", required=True)
    prior.add_argument("--exclude-run")
    prior.add_argument("--format", choices=("json", "prompt"), default="json")
    prior.set_defaults(func=feedback)

    addressed = commands.add_parser(
        "address", help="append a later-run replacement link for an annotation"
    )
    addressed.add_argument("--workspace", required=True)
    addressed.add_argument("--run-id", required=True, help="original annotated run")
    addressed.add_argument("--annotation-id", required=True)
    addressed.add_argument("--later-run-id", required=True)
    addressed.add_argument("--replacement-claim-id", required=True)
    addressed.add_argument("--operation-id", required=True)
    addressed.add_argument("--note", default="")
    addressed.set_defaults(func=address)
    return result


def main() -> None:
    args = parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
