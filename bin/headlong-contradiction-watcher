#!/usr/bin/env python3
"""Conservative, read-only contradiction detection with a private shadow ledger.

This command has no delivery implementation. It reads markdown memories, writes
only to its ledger directory, and records candidates for human review. Running
it is an explicit session/goal-boundary action; it does not install a timer.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import sys
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Iterable


BELIEF_KINDS = {"belief", "value", "preference"}
ACTION_KINDS = {"action", "decision", "goal", "objective"}
KNOWN_KINDS = BELIEF_KINDS | ACTION_KINDS
TRUTHY = {"1", "true", "yes", "y", "consequential", "material"}
STOPWORDS = {
    "about", "across", "after", "again", "against", "also", "and", "are",
    "because", "been", "before", "being", "but", "can", "complete", "did",
    "does", "doing", "for", "from", "goal", "have", "into", "its", "just",
    "more", "most", "not", "now", "only", "our", "out", "over", "personal",
    "same", "should", "since", "some", "standing", "than", "that", "the",
    "their", "then", "there", "these", "they", "this", "toma", "treasurer",
    "under", "very", "was", "were", "what", "when", "where", "which", "while",
    "will", "with", "work", "would", "you", "your",
    *KNOWN_KINDS,
}
RESTRICTIVE = {
    "avoid", "exclude", "never", "no", "not", "private", "protect", "refuse",
    "stop", "unscheduled", "without", "local", "readonly", "read-only",
}
ACTIVATING = {
    "book", "build", "call", "deploy", "enable", "execute", "expose", "include",
    "install", "publish", "run", "schedule", "send", "sent", "share", "spend",
    "start", "use", "write",
}
COMMITTING = {
    "commit", "keep", "prefer", "prioritize", "protect", "use", "value", "want",
}
REVERSING = {
    "abandon", "disable", "ignore", "pause", "reject", "remove", "skip", "stop",
    "violate",
}


@dataclass(frozen=True)
class Memory:
    path: Path
    memory_id: str
    kind: str
    created: datetime
    summary: str
    body: str
    fields: dict[str, str]

    @property
    def text(self) -> str:
        return f"{self.summary}\n{self.body}".strip()


def parse_time(value: str) -> datetime:
    value = value.strip().replace("Z", "+00:00")
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def explicit_kind(raw_kind: str, body: str, summary: str) -> str:
    kind = raw_kind.strip().lower()
    if kind in KNOWN_KINDS:
        return kind
    # Legacy Headlong memories often stored the explicit label as the first
    # word of the body while frontmatter said `memory`. This is schema recovery,
    # not semantic classification: no label means the entry remains untyped.
    for text in (body, summary):
        match = re.match(
            r"^\s*(belief|value|preference|action|decision|goal|objective)\b(?:\s*[:—-])?\s+",
            text,
            re.IGNORECASE,
        )
        if match:
            return match.group(1).lower()
    return ""


def parse_memory(path: Path) -> Memory | None:
    try:
        raw = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return None
    if not raw.startswith("---\n"):
        return None
    parts = raw.split("---\n", 2)
    if len(parts) != 3:
        return None
    fields: dict[str, str] = {}
    for line in parts[1].splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            fields[key.strip().lower()] = value.strip().strip('"\'')
    body = parts[2].strip()
    summary = fields.get("summary", "").strip()
    kind = explicit_kind(fields.get("type", ""), body, summary)
    if not kind:
        return None
    try:
        created = parse_time(fields["created"])
    except (KeyError, ValueError):
        return None
    memory_id = fields.get("id") or hashlib.sha256(str(path).encode()).hexdigest()[:12]
    return Memory(path, memory_id, kind, created, summary, body, fields)


def words(text: str) -> set[str]:
    return {
        word for word in re.findall(r"[a-z0-9][a-z0-9_-]{2,}", text.lower())
        if word not in STOPWORDS
    }


def has_root(tokens: set[str], roots: set[str]) -> bool:
    for token in tokens:
        for root in roots:
            if token == root or (len(root) >= 4 and token.startswith(root)):
                return True
    return False


def same_subject(left: Memory, right: Memory) -> tuple[bool, list[str]]:
    left_topic = left.fields.get("topic", "").strip().lower()
    right_topic = right.fields.get("topic", "").strip().lower()
    if left_topic and left_topic == right_topic:
        return True, [f"topic:{left_topic}"]
    overlap = sorted(words(left.text) & words(right.text))
    return len(overlap) >= 2, overlap


def directional_tension(belief: Memory, action: Memory) -> tuple[bool, str]:
    belief_words = words(belief.text)
    action_words = words(action.text)
    if has_root(belief_words, RESTRICTIVE) and has_root(action_words, ACTIVATING):
        return True, "restrictive belief versus activating action"
    if has_root(belief_words, COMMITTING) and has_root(action_words, REVERSING):
        return True, "stated commitment versus reversing action"
    return False, ""


def stated_by_toma(memory: Memory) -> bool:
    origin = " ".join(
        memory.fields.get(key, "") for key in ("stated_by", "author", "source")
    ).lower()
    return bool(re.search(r"\b(toma|user)\b", origin))


def consequential(memory: Memory) -> bool:
    if memory.kind in {"decision", "goal", "objective"}:
        return True
    value = " ".join(
        memory.fields.get(key, "") for key in ("consequential", "materiality")
    ).lower()
    return any(token in TRUTHY for token in re.findall(r"[a-z0-9-]+", value))


def later_resolution(
    belief: Memory, action: Memory, beliefs: Iterable[Memory]
) -> Memory | None:
    for possible in beliefs:
        if belief.created < possible.created <= action.created:
            matches, _ = same_subject(possible, action)
            if matches:
                return possible
    return None


def append_jsonl(path: Path, record: dict[str, object]) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        os.write(descriptor, (json.dumps(record, sort_keys=True) + "\n").encode())
    finally:
        os.close(descriptor)


def ensure_private_file(path: Path) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
    finally:
        os.close(descriptor)


def known_ids(path: Path) -> set[str]:
    ids: set[str] = set()
    if not path.exists():
        return ids
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            value = json.loads(line).get("candidate_id")
            if value:
                ids.add(value)
        except (json.JSONDecodeError, AttributeError):
            continue
    return ids


def iso(value: datetime) -> str:
    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mem-dir", required=True, type=Path)
    parser.add_argument("--ledger-dir", required=True, type=Path)
    parser.add_argument("--window-days", type=int, default=14)
    parser.add_argument("--trigger", default="manual-boundary")
    parser.add_argument("--now", help="UTC ISO time; intended for reproducible tests")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if args.window_days <= 0:
        parser.error("--window-days must be positive")
    now = parse_time(args.now) if args.now else datetime.now(timezone.utc)
    if not args.mem_dir.is_dir():
        parser.error(f"memory directory does not exist: {args.mem_dir}")

    args.ledger_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(args.ledger_dir, 0o700)
    lock_path = args.ledger_dir / ".lock"
    lock_fd = os.open(lock_path, os.O_WRONLY | os.O_CREAT, 0o600)
    os.fchmod(lock_fd, 0o600)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)

    candidate_path = args.ledger_dir / "candidates.jsonl"
    screened_path = args.ledger_dir / "screened.jsonl"
    runs_path = args.ledger_dir / "runs.jsonl"
    for ledger_path in (candidate_path, screened_path, runs_path):
        ensure_private_file(ledger_path)
    existing_candidates = known_ids(candidate_path)
    existing_screened = known_ids(screened_path)

    entries = [entry for path in sorted(args.mem_dir.glob("*.md")) if (entry := parse_memory(path))]
    beliefs = [entry for entry in entries if entry.kind in BELIEF_KINDS]
    actions = [entry for entry in entries if entry.kind in ACTION_KINDS]
    new_candidates = 0
    screened_conflicts = 0
    considered_pairs = 0

    for belief in beliefs:
        for action in actions:
            if action.created < belief.created or action.created > now:
                continue
            considered_pairs += 1
            subject_match, overlap = same_subject(belief, action)
            tension, tension_reason = directional_tension(belief, action)
            if not (subject_match and tension):
                continue

            candidate_id = hashlib.sha256(
                f"{belief.memory_id}\0{action.memory_id}".encode()
            ).hexdigest()[:20]
            resolution = later_resolution(belief, action, beliefs)
            recent = action.created >= now - timedelta(days=args.window_days)
            origin_ok = stated_by_toma(belief)
            consequential_ok = consequential(action)
            rejection_reasons = []
            if resolution:
                rejection_reasons.append(f"later belief/value entry {resolution.memory_id} may resolve the shift")
            if not recent:
                rejection_reasons.append(f"action is older than {args.window_days} days")
            if not origin_ok:
                rejection_reasons.append("belief is not explicitly attributed to Toma/user")
            if not consequential_ok:
                rejection_reasons.append("action is not explicitly consequential")

            common = {
                "candidate_id": candidate_id,
                "mode": "shadow",
                "delivery": "disabled",
                "requires_human_review": True,
                "belief": {
                    "id": belief.memory_id,
                    "kind": belief.kind,
                    "created": iso(belief.created),
                    "summary": belief.summary,
                    "path": belief.path.name,
                },
                "action": {
                    "id": action.memory_id,
                    "kind": action.kind,
                    "created": iso(action.created),
                    "summary": action.summary,
                    "path": action.path.name,
                },
                "subject_overlap": overlap,
                "tension": tension_reason,
                "evaluated_at": iso(now),
            }
            if rejection_reasons:
                screened_conflicts += 1
                if candidate_id not in existing_screened:
                    append_jsonl(
                        screened_path,
                        {**common, "status": "screened-out", "reasons": rejection_reasons},
                    )
                    existing_screened.add(candidate_id)
                continue

            if candidate_id not in existing_candidates:
                append_jsonl(candidate_path, {**common, "status": "candidate"})
                existing_candidates.add(candidate_id)
                new_candidates += 1

    run_id = hashlib.sha256(
        f"{iso(now)}\0{args.trigger}\0{len(entries)}".encode()
    ).hexdigest()[:20]
    summary = {
        "run_id": run_id,
        "mode": "shadow",
        "delivery": "disabled",
        "trigger": args.trigger,
        "evaluated_at": iso(now),
        "memory_files": len(list(args.mem_dir.glob("*.md"))),
        "typed_entries": len(entries),
        "belief_entries": len(beliefs),
        "action_entries": len(actions),
        "considered_pairs": considered_pairs,
        "screened_conflicts": screened_conflicts,
        "new_candidates": new_candidates,
        "candidate_total": len(existing_candidates),
    }
    append_jsonl(runs_path, summary)
    if args.json:
        print(json.dumps(summary, sort_keys=True))
    else:
        print(
            f"shadow watcher: {new_candidates} new candidate(s); "
            f"delivery disabled; ledger={args.ledger_dir}"
        )
    fcntl.flock(lock_fd, fcntl.LOCK_UN)
    os.close(lock_fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
